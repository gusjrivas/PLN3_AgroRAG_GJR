# Copiar fuera del repositorio y reemplazar todos los placeholders.
# Los secretos son archivos bajo AGRO_SECRETS_DIR; nunca agregarlos aquí.
AGRO_API_IMAGE=ghcr.io/<owner>/<repo>/api@sha256:<digest-api>
AGRO_UI_IMAGE=ghcr.io/<owner>/<repo>/ui@sha256:<digest-ui>
AGRO_GATEWAY_IMAGE=ghcr.io/<owner>/<repo>/gateway@sha256:<digest-gateway>
AGRO_CATALOGUE_VOLUME=<volumen-externo>
AGRO_DOMAIN=<staging.example.org>
AGRO_OPENAI_MODEL=<modelo-autorizado>
AGRO_SECRETS_DIR=</ruta/absoluta/secrets>
AGRO_RELEASE_VERSION=<MAJOR.MINOR.PATCH-rc.N>
AGRO_COMMIT_SHA=<sha-completo-40-hex>
AGRO_HTTP_PORT=80
AGRO_HTTPS_PORT=443
AGRO_CADDY_DATA_VOLUME=<volumen-caddy-data>
AGRO_CADDY_CONFIG_VOLUME=<volumen-caddy-config>
