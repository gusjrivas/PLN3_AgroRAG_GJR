# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337

FROM ${PYTHON_IMAGE}

ARG GARAK_VERSION=0.17.0
ARG VCS_REF=unknown
ARG SOURCE_URL=https://github.com/gusjrivas/PLN3_AgroRAG_GJR
ARG TARGETARCH

LABEL org.opencontainers.image.title="AgroRAG garak runner" \
      org.opencontainers.image.description="One-shot adversarial evaluation runner" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.version="${GARAK_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}"

COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /bin/uv
COPY infra/garak/requirements.lock /tmp/garak-requirements.lock

RUN --mount=type=cache,target=/root/.cache/uv \
    test "$TARGETARCH" = "amd64" \
    && grep -Fx "garak==0.17.0" /tmp/garak-requirements.lock \
    && apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10003 scanner \
    && useradd --uid 10003 --gid 10003 --no-create-home --shell /usr/sbin/nologin scanner \
    && uv pip install --system --requirement /tmp/garak-requirements.lock \
    && rm /tmp/garak-requirements.lock \
    && mkdir -p /opt/agrorag /reports/raw /reports/summary \
    && chown -R 10003:10003 /opt/agrorag /reports

COPY --chown=10003:10003 scripts/garak_adapter.py /opt/agrorag/garak_adapter.py
COPY --chown=10003:10003 scripts/check_garak_policy.py /opt/agrorag/check_garak_policy.py
COPY --chown=10003:10003 scripts/run_garak.py /opt/agrorag/run_garak.py
COPY --chown=10003:10003 infra/garak /opt/agrorag/config

ENV HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    XDG_CONFIG_HOME=/tmp/.config \
    XDG_DATA_HOME=/tmp/.local/share \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER 10003:10003
ENTRYPOINT ["python", "/opt/agrorag/run_garak.py"]

