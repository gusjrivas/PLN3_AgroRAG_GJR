# Generate a private reader token; leave blank to keep endpoints closed.
AGRO_READER_KEY=
AGRO_API_URL=http://127.0.0.1:8000
AGRO_CATALOGUE_PATH=data/processed/catalogue
AGRO_OLLAMA_URL=http://127.0.0.1:11434
# Exact installed Ollama model name:tag. Blank = source exploration only.
AGRO_MODEL=

# Optional administrative Pinecone adapter. Keep the real value out of this tracked file.
PINECONE_API_KEY=
PINECONE_INDEX=pln3-agrorag-e5-384
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Blank derives an immutable namespace from the active corpus version.
PINECONE_NAMESPACE=
AGRO_EMBEDDING_MODEL=intfloat/multilingual-e5-small
AGRO_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
AGRO_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AGRO_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
