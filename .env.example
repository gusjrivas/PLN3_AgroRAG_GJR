# Generate a private reader token; leave blank to keep endpoints closed.
AGRO_READER_KEY=
AGRO_API_URL=http://127.0.0.1:8000
AGRO_CATALOGUE_PATH=data/processed/catalogue
# Select exactly one generation provider: ollama or openai.
AGRO_MODEL_PROVIDER=ollama
AGRO_OLLAMA_URL=http://127.0.0.1:11434
# Exact installed Ollama model name:tag. Blank = source exploration only.
AGRO_MODEL=

# OpenAI Responses API. Keep the real key only in the ignored .env file.
OPENAI_API_KEY=
AGRO_OPENAI_MODEL=gpt-4o
AGRO_OPENAI_URL=https://api.openai.com/v1

# Optional administrative Pinecone adapter. Keep the real value out of this tracked file.
PINECONE_API_KEY=
PINECONE_INDEX=pln3-agrorag-e5-384
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Blank derives an immutable namespace from the active corpus version.
PINECONE_NAMESPACE=
AGRO_EMBEDDING_MODEL=intfloat/multilingual-e5-small
AGRO_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
AGRO_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AGRO_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

# Public retrieval remains bm25 unless semantic activation is explicit and complete.
# Allowed: bm25, vector, hybrid, hybrid_rerank.
AGRO_RETRIEVAL_MODE=bm25
# Exact tokenizer used by the configured generator; both fields are mandatory for semantic modes.
AGRO_RETRIEVAL_TOKENIZER_MODEL=
AGRO_RETRIEVAL_TOKENIZER_REVISION=
# Fail closed instead of downloading model files during API startup.
AGRO_SEMANTIC_LOCAL_FILES_ONLY=true
AGRO_RETRIEVAL_TOKEN_BUDGET=3000
AGRO_RETRIEVAL_SOURCE_CAP=2
AGRO_RETRIEVAL_MAX_ITEMS=4
AGRO_RETRIEVAL_CANDIDATE_LIMIT=20
